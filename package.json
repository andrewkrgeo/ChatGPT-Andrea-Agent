{
  "name": "chatgpt-code-agent",
  "displayName": "ChatGPT Code Agent",
  "description": "Workspace-scoped coding agent powered by OpenAI Responses API",
  "version": "0.5.5",
  "publisher": "local-dev",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:chatgptAgent.chat",
    "onCommand:chatgptAgent.setApiKey",
    "onCommand:chatgptAgent.openChat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "chatgptAgent.setApiKey",
        "title": "ChatGPT Agent: Set API Key"
      },
      {
        "command": "chatgptAgent.openChat",
        "title": "ChatGPT Agent: Open Chat"
      },
      {
        "command": "chatgptAgent.reset",
        "title": "ChatGPT Agent: Reset Conversation"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatgptAgent",
          "title": "ChatGPT Agent",
          "icon": "media/robot.svg"
        }
      ]
    },
    "views": {
      "chatgptAgent": [
        {
          "id": "chatgptAgent.chat",
          "name": "Agent Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "ChatGPT Code Agent",
      "properties": {
        "chatgptAgent.model": {
          "type": "string",
          "default": "gpt-6.1-sol",
          "description": "OpenAI model used by the coding agent. Your API account must have access.",
          "enum": [
            "gpt-6-luna",
            "gpt-6.1-sol",
            "gpt-6-astra"
          ],
          "enumDescriptions": [
            "Efficient and economical",
            "Balanced for coding and cost",
            "Strongest for challenging tasks"
          ]
        },
        "chatgptAgent.maxSteps": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 60,
          "description": "Maximum agent tool rounds per user message."
        },
        "chatgptAgent.commandTimeoutSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 300
        },
        "chatgptAgent.maxOutputChars": {
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 40000
        },
        "chatgptAgent.reasoningEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium",
          "description": "Reasoning effort for Responses API (more effort can take longer and cost more)."
        },
        "chatgptAgent.autoConsolidate": {
          "type": "boolean",
          "default": true,
          "description": "After each completed agent task, make one extra OpenAI API request to summarize durable project knowledge in .andrea/MEMORY.md and log a concise summary to .andrea/summaries.jsonl (additional API cost)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.8.0"
  }
}
